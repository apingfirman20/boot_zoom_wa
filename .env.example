# ==============================================================
# KONFIGURASI ENVIRONMENT VARIABLES - BOT WHATSAPP AI ZOOM (SCAN QR)
# ==============================================================
# Salin file ini ke .env: cp .env.example .env

# --------------------------------------------------------------
# 1. GOOGLE GEMINI API (WAJIB)
# --------------------------------------------------------------
# Dapatkan API Key GRATIS dari Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Model Gemini yang digunakan (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------
# 2. ZOOM API (SERVER-TO-SERVER OAUTH) (WAJIB)
# --------------------------------------------------------------
# Dapatkan dari Zoom App Marketplace (https://marketplace.zoom.us/)
# Buat App "Server-to-Server OAuth" dengan scopes: meeting:write:admin
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# --------------------------------------------------------------
# 3. PENGATURAN UMUM / TIMEZONE
# --------------------------------------------------------------
# Timezone default untuk jadwal meeting (default: Asia/Jakarta untuk WIB)
DEFAULT_TIMEZONE=Asia/Jakarta
